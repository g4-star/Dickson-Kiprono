@import url('https://fonts.googleapis.com/css2?family=DM+Mono:wght@400;500&family=Manrope:wght@400;500;600;700;800&display=swap');

:root {
  --bg: #ffffff;
  --surface: #f7f7f8;
  --surface-strong: #eeeeef;
  --text: #09090b;
  --muted: #66666d;
  --border: #dedee3;
  --accent: #5757f7;
  --accent-dark: #4242df;
  --nav-bg: rgba(255, 255, 255, 0.88);
  --shadow: 0 20px 60px rgba(0, 0, 0, 0.08);
  --max: 1240px;
}

:root.dark {
  --bg: #000000;
  --surface: #0b0b0c;
  --surface-strong: #151516;
  --text: #ffffff;
  --muted: #99999f;
  --border: #252528;
  --accent: #7777ff;
  --accent-dark: #6666ee;
  --nav-bg: rgba(0, 0, 0, 0.88);
  --shadow: 0 20px 70px rgba(0, 0, 0, 0.45);
}

* {
  box-sizing: border-box;
}

html {
  scroll-behavior: smooth;
  scroll-padding-top: 88px;
}

body {
  margin: 0;
  min-width: 320px;
  background: var(--bg);
  color: var(--text);
  font-family: "Manrope", sans-serif;
  transition:
    background-color 0.3s ease,
    color 0.3s ease;
}

button,
a {
  font: inherit;
}

button {
  cursor: pointer;
}

a {
  color: inherit;
  text-decoration: none;
}

.site {
  min-height: 100vh;
  overflow-x: hidden;
  background: var(--bg);
}

/* =========================
   NAVBAR
========================= */

.navbar {
  position: sticky;
  top: 0;
  z-index: 1000;
  width: 100%;
  border-bottom: 1px solid var(--border);
  background: var(--nav-bg);
  backdrop-filter: blur(18px);
  -webkit-backdrop-filter: blur(18px);
}

.nav-inner {
  width: min(var(--max), calc(100% - 48px));
  height: 76px;
  margin: 0 auto;
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 28px;
}

.brand {
  border: 0;
  background: transparent;
  color: var(--text);
  display: flex;
  align-items: center;
  gap: 11px;
  padding: 0;
  flex-shrink: 0;
}

.brand-mark {
  width: 38px;
  height: 38px;
  display: grid;
  place-items: center;
  background: var(--text);
  color: var(--bg);
  font-family: "DM Mono", monospace;
  font-size: 12px;
  font-weight: 500;
}

.brand-name {
  font-size: 15px;
  font-weight: 800;
  letter-spacing: -0.03em;
}

.nav-links {
  display: flex;
  align-items: center;
  justify-content: center;
  gap: 4px;
}

.nav-links button {
  border: 0;
  background: transparent;
  color: var(--muted);
  padding: 9px 10px;
  font-family: "Manrope", sans-serif;
  font-size: 11px;
  font-weight: 700;
  cursor: pointer;
  white-space: nowrap;
  transition:
    color 0.2s ease,
    background 0.2s ease;
}

.nav-links button:hover {
  color: var(--text);
  background: var(--surface);
}

.nav-link {
  border: 0;
  background: transparent;
  color: var(--muted);
  padding: 9px 10px;
  font-size: 11px;
  font-weight: 700;
}

.nav-actions {
  display: flex;
  align-items: center;
  gap: 8px;
}

.theme-btn,
.menu-btn {
  width: 38px;
  height: 38px;
  display: grid;
  place-items: center;
  border: 1px solid var(--border);
  background: var(--surface);
  color: var(--text);
}

.menu-btn {
  display: none;
}

/* =========================
   GLOBAL
========================= */

.section {
  width: min(var(--max), calc(100% - 48px));
  margin: 0 auto;
  padding: 110px 0;
}

.section-heading {
  margin-bottom: 54px;
}

.section-number {
  display: block;
  margin-bottom: 16px;
  color: var(--accent);
  font-family: "DM Mono", monospace;
  font-size: 11px;
  letter-spacing: 0.1em;
}

.section-heading h2 {
  max-width: 850px;
  margin: 0;
  font-size: clamp(38px, 5vw, 72px);
  line-height: 0.98;
  letter-spacing: -0.055em;
}

.section-heading p {
  max-width: 650px;
  margin: 22px 0 0;
  color: var(--muted);
  font-size: 16px;
  line-height: 1.8;
}

/* =========================
   HERO
========================= */

.hero {
  min-height: calc(100vh - 76px);
  padding-top: 90px;
  padding-bottom: 80px;
  display: flex;
  align-items: center;
}

.hero-grid {
  width: 100%;
  display: grid;
  grid-template-columns: 1.02fr 0.98fr;
  gap: 70px;
  align-items: center;
}

.hero-copy {
  position: relative;
  z-index: 2;
}

.eyebrow {
  display: flex;
  align-items: center;
  gap: 10px;
  color: var(--muted);
  font-family: "DM Mono", monospace;
  font-size: 11px;
  letter-spacing: 0.08em;
  text-transform: uppercase;
}

.pulse {
  width: 8px;
  height: 8px;
  border-radius: 50%;
  background: #38c172;
  box-shadow: 0 0 0 6px rgba(56, 193, 114, 0.12);
}

.hero h1 {
  max-width: 780px;
  margin: 24px 0;
  font-size: clamp(58px, 8vw, 110px);
  line-height: 0.88;
  letter-spacing: -0.075em;
}

.hero-description {
  max-width: 600px;
  margin: 0 0 34px;
  color: var(--muted);
  font-size: 17px;
  line-height: 1.8;
}

.hero-buttons {
  display: flex;
  flex-wrap: wrap;
  gap: 12px;
}

.btn {
  min-height: 50px;
  display: inline-flex;
  align-items: center;
  justify-content: center;
  gap: 10px;
  padding: 0 20px;
  border: 1px solid var(--border);
  transition:
    transform 0.2s ease,
    background 0.2s ease,
    color 0.2s ease,
    border-color 0.2s ease;
}

.btn:hover {
  transform: translateY(-2px);
}

.btn-primary {
  border-color: var(--text);
  background: var(--text);
  color: var(--bg);
}

.btn-outline {
  background: transparent;
  color: var(--text);
}

.hero-socials {
  margin-top: 30px;
  display: flex;
  align-items: center;
  gap: 22px;
}

.hero-socials a {
  display: inline-flex;
  align-items: center;
  gap: 8px;
  color: var(--muted);
  font-size: 12px;
  font-weight: 700;
  transition: color 0.2s ease;
}

.hero-socials a:hover {
  color: var(--text);
}

.social-brand {
  width: 18px;
  height: 18px;
  display: inline-grid;
  place-items: center;
  border: 1px solid currentColor;
  border-radius: 4px;
  font-family: "DM Mono", monospace;
  font-size: 8px;
  font-weight: 700;
  line-height: 1;
}

.hero-visual {
  min-height: 600px;
  position: relative;
  display: flex;
  align-items: center;
  justify-content: center;
}

.visual-grid {
  position: absolute;
  inset: 5%;
  background-image:
    linear-gradient(var(--border) 1px, transparent 1px),
    linear-gradient(90deg, var(--border) 1px, transparent 1px);
  background-size: 42px 42px;
  opacity: 0.35;
  mask-image: radial-gradient(circle, black 25%, transparent 75%);
  -webkit-mask-image: radial-gradient(circle, black 25%, transparent 75%);
}

.profile-frame {
  width: min(410px, 72%);
  aspect-ratio: 0.82;
  position: relative;
  z-index: 2;
  border: 1px solid var(--border);
  background: var(--surface);
  box-shadow: var(--shadow);
  overflow: hidden;
}

.profile-placeholder {
  width: 100%;
  height: 100%;
  display: grid;
  place-items: center;
  background:
    radial-gradient(circle at 50% 40%, rgba(87, 87, 247, 0.2), transparent 35%),
    var(--surface);
}

.profile-initials {
  font-size: clamp(70px, 10vw, 130px);
  font-weight: 800;
  letter-spacing: -0.09em;
}

.profile-caption {
  position: absolute;
  left: 22px;
  bottom: 20px;
  color: var(--muted);
  font-family: "DM Mono", monospace;
  font-size: 9px;
  letter-spacing: 0.08em;
  text-transform: uppercase;
}

.floating-card {
  position: absolute;
  z-index: 4;
  min-width: 180px;
  padding: 17px;
  border: 1px solid var(--border);
  background: color-mix(in srgb, var(--bg) 90%, transparent);
  box-shadow: var(--shadow);
  backdrop-filter: blur(12px);
}

.card-one {
  left: 0;
  top: 22%;
}

.card-two {
  right: 0;
  bottom: 22%;
}

.floating-card small {
  display: block;
  margin-bottom: 7px;
  color: var(--muted);
  font-family: "DM Mono", monospace;
  font-size: 9px;
  text-transform: uppercase;
}

.floating-card strong {
  font-size: 13px;
}

.visual-code {
  position: absolute;
  right: 5%;
  top: 8%;
  z-index: 3;
  padding: 13px;
  border: 1px solid var(--border);
  background: var(--bg);
  color: var(--accent);
  font-family: "DM Mono", monospace;
  font-size: 10px;
  line-height: 1.7;
  opacity: 0.9;
}

/* =========================
   STATS
========================= */

.stats-strip {
  width: min(var(--max), calc(100% - 48px));
  margin: 0 auto;
  display: grid;
  grid-template-columns: repeat(4, 1fr);
  border-top: 1px solid var(--border);
  border-bottom: 1px solid var(--border);
}

.stat {
  min-height: 150px;
  padding: 28px;
  border-right: 1px solid var(--border);
}

.stat:last-child {
  border-right: 0;
}

.stat-value {
  display: block;
  margin-bottom: 12px;
  font-size: 42px;
  font-weight: 800;
  letter-spacing: -0.06em;
}

.stat-label {
  color: var(--muted);
  font-family: "DM Mono", monospace;
  font-size: 10px;
  text-transform: uppercase;
  letter-spacing: 0.08em;
}

/* =========================
   ABOUT
========================= */

.about-grid {
  display: grid;
  grid-template-columns: 1fr 1fr;
  gap: 80px;
}

.about-lead {
  font-size: clamp(25px, 3vw, 42px);
  line-height: 1.18;
  letter-spacing: -0.04em;
}

.about-lead p {
  margin: 0;
}

.about-details {
  display: grid;
  gap: 28px;
}

.about-detail {
  padding-top: 22px;
  border-top: 1px solid var(--border);
}

.about-detail h3 {
  margin: 0 0 10px;
  font-size: 15px;
}

.about-detail p {
  margin: 0;
  color: var(--muted);
  font-size: 14px;
  line-height: 1.8;
}

/* =========================
   DARK FEATURE SECTION
========================= */

.dark-section {
  width: 100%;
  background: #050505;
  color: #ffffff;
}

:root.dark .dark-section {
  background: #080808;
}

.dark-section .section-number,
.dark-section .muted {
  color: #888;
}

/* =========================
   MILESTONES
========================= */

.milestones-list {
  border-top: 1px solid #282828;
}

.milestone {
  display: grid;
  grid-template-columns: 100px 1fr 50px;
  gap: 25px;
  align-items: center;
  padding: 28px 0;
  border-bottom: 1px solid #282828;
  cursor: pointer;
  transition: padding 0.25s ease;
}

.milestone:hover,
.milestone.active {
  padding-left: 15px;
  padding-right: 15px;
}

.milestone-number {
  color: #777;
  font-family: "DM Mono", monospace;
  font-size: 11px;
}

.milestone h3 {
  margin: 0 0 7px;
  font-size: 25px;
  letter-spacing: -0.03em;
}

.milestone p {
  margin: 0;
  color: #888;
  font-size: 13px;
}

.milestone-arrow {
  width: 38px;
  height: 38px;
  display: grid;
  place-items: center;
  border: 1px solid #333;
}

.milestone-detail {
  margin-top: 35px;
  padding: 28px;
  border: 1px solid #292929;
  background: #0d0d0d;
}

.milestone-detail p {
  max-width: 800px;
  margin: 0;
  color: #aaa;
  line-height: 1.8;
}

/* =========================
   SERVICES
========================= */

.services-grid {
  display: grid;
  grid-template-columns: repeat(2, 1fr);
  border-top: 1px solid var(--border);
  border-left: 1px solid var(--border);
}

.service-card {
  min-height: 300px;
  padding: 34px;
  border-right: 1px solid var(--border);
  border-bottom: 1px solid var(--border);
  transition:
    background 0.25s ease,
    transform 0.25s ease;
}

.service-card:hover {
  background: var(--surface);
  transform: translateY(-3px);
}

.service-icon {
  width: 48px;
  height: 48px;
  display: grid;
  place-items: center;
  margin-bottom: 70px;
  border: 1px solid var(--border);
}

.service-card h3 {
  margin: 0 0 12px;
  font-size: 23px;
  letter-spacing: -0.035em;
}

.service-card p {
  margin: 0;
  color: var(--muted);
  font-size: 14px;
  line-height: 1.75;
}

/* =========================
   SKILLS
========================= */

.skills-layout {
  display: grid;
  grid-template-columns: 280px 1fr;
  gap: 70px;
}

.skill-tabs {
  display: grid;
  align-content: start;
  gap: 5px;
}

.skill-tab {
  display: flex;
  justify-content: space-between;
  align-items: center;
  border: 1px solid transparent;
  background: transparent;
  color: var(--muted);
  padding: 14px;
  text-align: left;
  font-size: 13px;
}

.skill-tab:hover,
.skill-tab.active {
  border-color: var(--border);
  background: var(--surface);
  color: var(--text);
}

.skills-content {
  min-height: 340px;
  padding: 35px;
  border: 1px solid var(--border);
  background: var(--surface);
}

.skills-content h3 {
  margin: 0 0 12px;
  font-size: 27px;
}

.skills-content > p {
  max-width: 650px;
  margin: 0 0 30px;
  color: var(--muted);
  line-height: 1.7;
}

.skill-tags {
  display: flex;
  flex-wrap: wrap;
  gap: 9px;
}

.skill-tag {
  padding: 10px 13px;
  border: 1px solid var(--border);
  background: var(--bg);
  font-family: "DM Mono", monospace;
  font-size: 10px;
}

/* =========================
   CERTIFICATIONS
========================= */

.cert-grid {
  display: grid;
  grid-template-columns: repeat(2, 1fr);
  gap: 15px;
}

.cert-card {
  min-height: 230px;
  padding: 28px;
  border: 1px solid var(--border);
  display: flex;
  flex-direction: column;
  justify-content: space-between;
  transition:
    transform 0.25s ease,
    background 0.25s ease;
}

.cert-card:hover {
  transform: translateY(-5px);
  background: var(--surface);
}

.cert-top {
  display: flex;
  align-items: center;
  justify-content: space-between;
}

.cert-index {
  color: var(--accent);
  font-family: "DM Mono", monospace;
  font-size: 10px;
}

.cert-card h3 {
  margin: 35px 0 8px;
  font-size: 21px;
}

.cert-card p {
  margin: 0;
  color: var(--muted);
  font-size: 13px;
  line-height: 1.7;
}

/* =========================
   PROJECTS
========================= */

.projects-list {
  display: grid;
  gap: 18px;
}

.project-card {
  position: relative;
  min-height: 330px;
  display: grid;
  grid-template-columns: 90px 1fr 160px;
  gap: 30px;
  padding: 35px;
  border: 1px solid var(--border);
  overflow: hidden;
  transition:
    transform 0.25s ease,
    background 0.25s ease;
}

.project-card:hover {
  transform: translateY(-4px);
  background: var(--surface);
}

.project-number {
  color: var(--accent);
  font-family: "DM Mono", monospace;
  font-size: 11px;
}

.project-content h3 {
  margin: 0 0 14px;
  font-size: clamp(28px, 4vw, 48px);
  letter-spacing: -0.05em;
}

.project-content p {
  max-width: 650px;
  margin: 0 0 24px;
  color: var(--muted);
  line-height: 1.8;
}

.project-stack {
  display: flex;
  flex-wrap: wrap;
  gap: 7px;
}

.project-stack span {
  padding: 7px 9px;
  border: 1px solid var(--border);
  font-family: "DM Mono", monospace;
  font-size: 9px;
}

.project-link {
  align-self: start;
  justify-self: end;
  display: inline-flex;
  align-items: center;
  gap: 7px;
  color: var(--accent);
  font-family: "DM Mono", monospace;
  font-size: 10px;
}

/* =========================
   JOURNEY
========================= */

.journey {
  position: relative;
}

.journey-track {
  position: relative;
  display: grid;
  grid-template-columns: repeat(4, 1fr);
  gap: 25px;
}

.journey-track::before {
  content: "";
  position: absolute;
  top: 10px;
  left: 0;
  right: 0;
  height: 1px;
  background: var(--border);
}

.journey-step {
  position: relative;
  padding-top: 42px;
}

.journey-dot {
  position: absolute;
  top: 3px;
  left: 0;
  width: 15px;
  height: 15px;
  border: 3px solid var(--bg);
  border-radius: 50%;
  background: var(--accent);
  box-shadow: 0 0 0 1px var(--border);
}

.journey-step span {
  color: var(--accent);
  font-family: "DM Mono", monospace;
  font-size: 10px;
}

.journey-step h3 {
  margin: 13px 0 10px;
  font-size: 19px;
}

.journey-step p {
  margin: 0;
  color: var(--muted);
  font-size: 13px;
  line-height: 1.7;
}

/* =========================
   OTHERS
========================= */

.others-grid {
  display: grid;
  grid-template-columns: repeat(4, 1fr);
  gap: 12px;
}

.other-card {
  min-height: 220px;
  padding: 25px;
  border: 1px solid var(--border);
  display: flex;
  flex-direction: column;
  justify-content: space-between;
  transition:
    transform 0.25s ease,
    background 0.25s ease;
}

.other-card:hover {
  transform: translateY(-4px);
  background: var(--surface);
}

.other-icon {
  width: 42px;
  height: 42px;
  display: grid;
  place-items: center;
  border: 1px solid var(--border);
}

.other-card h3 {
  margin: 0 0 8px;
  font-size: 17px;
}

.other-card p {
  margin: 0;
  color: var(--muted);
  font-size: 12px;
  line-height: 1.7;
}

/* =========================
   CONTACT
========================= */

.contact {
  padding-bottom: 130px;
}

.contact-box {
  position: relative;
  padding: 70px;
  border: 1px solid var(--border);
  background: var(--surface);
  overflow: hidden;
}

.contact-box::after {
  content: "";
  position: absolute;
  width: 400px;
  height: 400px;
  right: -170px;
  bottom: -220px;
  border-radius: 50%;
  background: var(--accent);
  opacity: 0.08;
  filter: blur(20px);
}

.contact-box h2 {
  max-width: 850px;
  margin: 0 0 22px;
  font-size: clamp(42px, 6vw, 80px);
  line-height: 0.95;
  letter-spacing: -0.06em;
}

.contact-box p {
  max-width: 600px;
  margin: 0 0 30px;
  color: var(--muted);
  line-height: 1.8;
}

.contact-links {
  display: flex;
  flex-wrap: wrap;
  gap: 10px;
}

/* =========================
   FOOTER
========================= */

.footer {
  border-top: 1px solid var(--border);
}

.footer-inner {
  width: min(var(--max), calc(100% - 48px));
  min-height: 100px;
  margin: 0 auto;
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 20px;
}

.footer p {
  margin: 0;
  color: var(--muted);
  font-size: 11px;
}

.footer-links {
  display: flex;
  gap: 18px;
}

.footer-links a {
  color: var(--muted);
  font-family: "DM Mono", monospace;
  font-size: 10px;
}

.footer-links a:hover {
  color: var(--text);
}

/* =========================
   SOCIAL ICON TEXT
========================= */

.social-icon-text {
  width: 28px;
  height: 28px;
  display: grid;
  place-items: center;
  border: 1px solid currentColor;
  font-family: "DM Mono", monospace;
  font-size: 9px;
  font-weight: 700;
}

/* =========================
   RESPONSIVE
========================= */

@media (max-width: 1050px) {
  .nav-links {
    gap: 0;
  }

  .nav-links button {
    padding: 9px 6px;
    font-size: 10px;
  }

  .hero-grid {
    gap: 40px;
  }

  .skills-layout {
    grid-template-columns: 220px 1fr;
  }

  .others-grid {
    grid-template-columns: repeat(2, 1fr);
  }
}

@media (max-width: 800px) {
  .nav-inner,
  .section,
  .stats-strip,
  .footer-inner {
    width: min(100% - 32px, var(--max));
  }

  .nav-inner {
    height: 68px;
  }

  .nav-links {
    position: absolute;
    left: 16px;
    right: 16px;
    top: 76px;
    display: none;
    flex-direction: column;
    align-items: stretch;
    padding: 10px;
    border: 1px solid var(--border);
    background: var(--bg);
    box-shadow: var(--shadow);
  }

  .nav-links.open {
    display: flex;
  }

  .nav-links button {
    width: 100%;
    padding: 13px;
    text-align: left;
  }

  .menu-btn {
    display: grid;
  }

  .hero {
    min-height: auto;
    padding-top: 70px;
  }

  .hero-grid,
  .about-grid {
    grid-template-columns: 1fr;
  }

  .hero h1 {
    font-size: clamp(52px, 13vw, 88px);
  }

  .hero-visual {
    min-height: 520px;
  }

  .stats-strip {
    grid-template-columns: repeat(2, 1fr);
  }

  .stat:nth-child(2) {
    border-right: 0;
  }

  .stat:nth-child(-n + 2) {
    border-bottom: 1px solid var(--border);
  }

  .services-grid,
  .cert-grid {
    grid-template-columns: 1fr;
  }

  .skills-layout {
    grid-template-columns: 1fr;
    gap: 25px;
  }

  .skill-tabs {
    grid-template-columns: repeat(2, 1fr);
  }

  .project-card {
    grid-template-columns: 60px 1fr;
  }

  .project-link {
    grid-column: 2;
    justify-self: start;
  }

  .journey-track {
    grid-template-columns: 1fr;
    gap: 35px;
  }

  .journey-track::before {
    top: 0;
    bottom: 0;
    left: 7px;
    width: 1px;
    height: auto;
  }

  .journey-step {
    padding-top: 0;
    padding-left: 35px;
  }

  .journey-dot {
    top: 3px;
  }

  .contact-box {
    padding: 40px 28px;
  }
}

@media (max-width: 520px) {
  .section {
    padding: 80px 0;
  }

  .brand-name {
    display: none;
  }

  .hero h1 {
    font-size: 52px;
  }

  .hero-description {
    font-size: 15px;
  }

  .hero-buttons {
    flex-direction: column;
    align-items: stretch;
  }

  .hero-buttons .btn {
    width: 100%;
  }

  .hero-visual {
    min-height: 430px;
  }

  .profile-frame {
    width: 75%;
  }

  .floating-card {
    min-width: 140px;
    padding: 12px;
  }

  .card-one {
    left: -5px;
  }

  .card-two {
    right: -5px;
  }

  .visual-code {
    display: none;
  }

  .stats-strip {
    grid-template-columns: 1fr 1fr;
  }

  .stat {
    min-height: 125px;
    padding: 20px 15px;
  }

  .stat-value {
    font-size: 32px;
  }

  .service-card {
    min-height: 250px;
    padding: 25px;
  }

  .service-icon {
    margin-bottom: 45px;
  }

  .skill-tabs {
    grid-template-columns: 1fr;
  }

  .skills-content {
    padding: 25px;
  }

  .project-card {
    grid-template-columns: 1fr;
    padding: 25px;
  }

  .project-link {
    grid-column: 1;
  }

  .others-grid {
    grid-template-columns: 1fr;
  }

  .contact-box h2 {
    font-size: 48px;
  }

  .footer-inner {
    padding: 25px 0;
    align-items: flex-start;
    flex-direction: column;
  }
}
