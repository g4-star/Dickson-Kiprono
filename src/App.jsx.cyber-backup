} from "lucide-react";

import { portfolio } from "./data/portfolio";
import "./App.css";

const navItems = [
  ["home", "Home"],
  ["about", "About"],
  ["work", "Work"],
  ["security", "Security"],
  ["stack", "Stack"],
  ["journey", "Journey"],
  ["services", "Services"],
  ["contact", "Contact"],
];

const capabilities = [
  {
    icon: ShieldCheck,
    title: "Cybersecurity",
    text: "Security-focused thinking across Linux environments, networking, defensive concepts, system hardening, digital investigations and practical security labs.",
  },
  {
    icon: Code2,
    title: "Software Development",
    text: "Building applications from idea to working product using modern frontend, backend and database technologies.",
  },
  {
    icon: Smartphone,
    title: "Mobile Development",
    text: "Developing Flutter applications with real backend integrations, authentication, data management, notifications and responsive interfaces.",
  },
  {
    icon: Globe,
    title: "Web Development",
    text: "Creating responsive websites and web applications with React, Vite, JavaScript and modern deployment workflows.",
  },
  {
    icon: Zap,
    title: "Automation & AI",
    text: "Exploring automation systems that reduce repetitive work while keeping workflows structured, transparent and controllable.",
  },
];

const securityAreas = [
  "Network security fundamentals",
  "Linux security and administration",
  "Zero Trust concepts",
  "Micro-segmentation",
  "Digital forensics",
  "Security monitoring concepts",
  "Threat awareness",
  "System hardening",
  "Security documentation",
  "Practical cybersecurity labs",
];

const learning = [
  {
    title: "Moringa School",
    text: "Cybersecurity training covering practical security concepts, technical labs, problem solving and collaborative project work.",
  },
  {
    title: "TryHackMe",
    text: "Hands-on security learning through guided rooms, practical challenges and security-focused environments.",
  },
  {
    title: "Cisco",
    text: "Networking and cybersecurity learning focused on foundational concepts and how systems communicate and are protected.",
  },
  {
    title: "Hack The Box",
    text: "Practical security experimentation and exposure to offensive security concepts through controlled environments.",
  },
];

const workflow = [
  ["01", "Understand", "Start with the actual problem, the people affected by it and the outcome the product should achieve."],
  ["02", "Plan", "Break the problem into features, data requirements, technical dependencies and realistic milestones."],
  ["03", "Build", "Implement the smallest useful version while keeping the architecture understandable and maintainable."],
  ["04", "Test", "Test functionality, edge cases, connectivity, data flow and security assumptions before release."],
  ["05", "Improve", "Use real feedback and observed failures to improve the product rather than treating the first release as finished."],
];

function App() {
  const [darkMode, setDarkMode] = useState(() => {
    const saved = localStorage.getItem("portfolio-theme");
    return saved ? saved === "dark" : true;
  });

  const [menuOpen, setMenuOpen] = useState(false);

  useEffect(() => {
    document.documentElement.dataset.theme = darkMode ? "dark" : "light";
    localStorage.setItem("portfolio-theme", darkMode ? "dark" : "light");
  }, [darkMode]);

  const scrollTo = (id) => {
    setMenuOpen(false);
    document.getElementById(id)?.scrollIntoView({ behavior: "smooth" });
  };

  return (
    <div className="site">
      <div className="noise" />

      <nav className="navbar">
        <div className="nav-inner">
          <button className="brand" onClick={() => scrollTo("home")}>
            <span className="brand-mark">DK</span>
            <span className="brand-copy">
              <strong>DICKSON</strong>
              <small>SECURITY / SOFTWARE</small>
            </span>
          </button>

          <div className={`nav-links ${menuOpen ? "open" : ""}`}>
            {navItems.map(([id, label]) => (
              <button key={id} onClick={() => scrollTo(id)}>
                {label}
              </button>
            ))}
          </div>

          <div className="nav-actions">
            <button
              className="theme-btn"
              aria-label="Toggle theme"
              onClick={() => setDarkMode((value) => !value)}
            >
              {darkMode ? <Sun size={17} /> : <Moon size={17} />}
            </button>

            <button
              className="menu-btn"
              aria-label="Toggle menu"
              onClick={() => setMenuOpen((value) => !value)}
            >
              {menuOpen ? <X size={21} /> : <Menu size={21} />}
            </button>
          </div>
        </div>
      </nav>

      <main>
        <section id="home" className="hero section">
          <div className="container hero-grid">
            <div className="hero-content">
              <div className="eyebrow">
                <span className="status-dot" />
                Available for opportunities · Kenya / Remote
              </div>

              <p className="hero-kicker">CYBERSECURITY × SOFTWARE</p>

              <h1>
                Building <span>secure</span> technology for real-world
                problems.
              </h1>

              <p className="hero-description">
                I’m Dickson Kiprono, a cybersecurity and software developer
                focused on turning practical problems into useful digital
                products. I work across security, mobile development, web
                applications, backend systems and automation.
              </p>

              <div className="hero-actions">
                <button className="btn btn-primary" onClick={() => scrollTo("work")}>
