                  <span />
                  <span />
                  <span />
                  <small>trippie@portfolio</small>
                </div>

                <div className="terminal-body">
                  <p>
                    <b>trippie@parrot</b>:<i>~</i>$ whoami
                  </p>
                  <p className="terminal-output">dickson-kiprono</p>

                  <p>
                    <b>trippie@parrot</b>:<i>~</i>$ cat focus.txt
