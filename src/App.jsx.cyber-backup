                <strong>{stat.value}</strong>
                <span>{stat.label}</span>
              </div>
            ))}
          </div>
        </section>

        <section id="about" className="section section-border">
          <div className="container">
            <div className="section-heading">
              <span className="section-number">01</span>
              <div>
                <p className="section-label">ABOUT</p>
                <h2>Technology should solve something.</h2>
              </div>
            </div>

            <div className="about-grid">
              <div className="about-main">
                <p className="lead">
                  I approach technology from two connected perspectives:
                  <strong> building systems</strong> and
                  <strong> understanding how those systems can fail.</strong>
                </p>

                <p>
                  My journey combines cybersecurity training with hands-on
