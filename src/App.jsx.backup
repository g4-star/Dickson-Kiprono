                  <span>{item.date}</span>
                  <h3>{item.title}</h3>
                  <p>{item.text}</p>
                </div>
              </article>
            ))}
          </div>
        </section>

        {/* OTHERS */}
        <section id="others" className="section dark-section others-section">
          <div className="section-heading light-heading">
            <span className="section-number">08 / OTHERS</span>
            <h2>Beyond the projects.</h2>
          </div>

          <div className="others-grid">
            <a
              className="other-card"
              href={portfolio.social.github}
              target="_blank"
