                  </div>
                ))}
              </div>
            </div>
          </div>
        </section>

        {/* CERTIFICATIONS */}
        <section id="certifications" className="section certification-section">
          <div className="section-heading">
            <span className="section-number">05 / CERTIFICATIONS</span>
            <h2>Learning never stops.</h2>
          </div>

