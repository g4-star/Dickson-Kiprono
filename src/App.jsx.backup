                  <div className="project-grid-lines" />
                  <div className="project-corner">CASE / {String(index + 1).padStart(2, "0")}</div>
                </div>

                <div className="project-info">
                  <div>
                    <h3>{project.title}</h3>
                    <strong>{project.subtitle}</strong>
