            >
              <span className="social-icon-text">GH</span>
              <span>01</span>
              <h3>GitHub</h3>
              <p>Code, experiments, repositories and things currently being built.</p>
              <ArrowUpRight size={18} />
            </a>

            <a
              className="other-card"
              href={portfolio.social.linkedin}
              target="_blank"
              rel="noreferrer"
            >
              <span className="social-icon-text">in</span>
              <span>02</span>
              <h3>LinkedIn</h3>
              <p>Professional journey, opportunities and technical growth.</p>
              <ArrowUpRight size={18} />
            </a>

            <div className="other-card">
              <Terminal size={28} />
              <span>03</span>
              <h3>Linux</h3>
              <p>Comfortable working in terminal-driven development environments.</p>
              <ArrowUpRight size={18} />
            </div>

            <div className="other-card">
              <Shield size={28} />
              <span>04</span>
              <h3>Security Mindset</h3>
              <p>Think about how systems can fail, how they can be protected and how they can improve.</p>
              <ArrowUpRight size={18} />
            </div>
          </div>
        </section>

        {/* CONTACT */}
        <section id="contact" className="section contact-section">
          <div className="contact-copy">
            <span className="section-number">09 / CONTACT</span>
            <h2>
              Have an idea?
              <br />
              <em>Let&apos;s build it.</em>
            </h2>
            <p>
              I&apos;m open to internships, junior opportunities, freelance
