{
  "rewrites": [
    {
      "source": "/api/private-admin-blob-upload",
      "destination": "/api/private-admin-content"
    },
    {
      "source": "/api/private-admin-content-create",
      "destination": "/api/private-admin-content"
    },
    {
      "source": "/api/admin-login",
      "destination": "/api/admin-auth?action=login"
    },
    {
      "source": "/api/admin-logout",
      "destination": "/api/admin-auth?action=logout"
    },
    {
      "source": "/((?!api/).*)",
      "destination": "/index.html"
    }
  ]
}
